;; Workspace-local git deps only, plus org.clojure/clojure (inherited from
;; the install-level deps.edn, same as org-modbus/org-ietf-rtp — neither
;; declares :deps at all).
;;
;; org-ietf-rtp: SRTP transforms RTP packets, so this depends on that
;; codec rather than re-parsing the RTP header — the same call
;; org-ietf-rtp's own README makes for why it does not re-implement SDP.
;;
;; kotoba-lang/bytes: RFC 3711's default authentication transform is
;; HMAC-SHA1 (RFC 2104), which already exists here, real and tested
;; against a published vector (see kotoba.bytes.sha1's own test suite) —
;; implementing a second one would be exactly the "112 repos each
;; hand-rolling sha256/HMAC" problem that repo's own README documents.
;;
;; org-nist-aes: RFC 3711's default cipher is AES in Segmented Integer
;; Counter Mode (AES-CM, a close relative of the AES-CTR this workspace
;; otherwise has none of). `aes.core` supplies the *block cipher*
;; (key schedule + forward-only encrypt-block, which is all CTR-family
;; modes ever call); `srtp.aes-cm` in this repo builds the counter-mode
;; wrapper AES-CM/SRTP's key-derivation function needs on top of it, and
;; is tested against RFC 3711 Appendix B's own published vectors — see
;; that namespace's docstring for exactly what is reused vs. new here.
{:paths ["src"]
 :deps {kotoba-lang/org-ietf-rtp
        {:git/url "https://github.com/kotoba-lang/org-ietf-rtp.git"
         :git/sha "61769c62903af22c488355755d86b0a4d230ba78"}
        kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/bytes.git"
         :git/sha "acf1e1a3ed9063211e5a94b094b85b72e1917331"}
        kotoba-lang/org-nist-aes
        {:git/url "https://github.com/kotoba-lang/org-nist-aes.git"
         :git/sha "7834b2f04729ab77259da26a8d728fe3595f041e"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :cljs {:extra-paths ["test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
